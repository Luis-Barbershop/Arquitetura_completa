<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ifsp.edu.projeto</groupId>
        <artifactId>cortaai</artifactId>
        <version>0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>coverage-report</artifactId>
    <name>coverage-report</name>
    <description>Relatório agregado de cobertura de testes (JaCoCo) de todos os microsserviços</description>

    <build>
        <plugins>
            <!-- Desabilita o repackage do Spring Boot — este módulo não tem main class -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>CortaAi — Cobertura de Testes (todos os microsserviços)</title>
                            <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                            <dataFileIncludes>
                                <dataFileInclude>**/target/jacoco.exec</dataFileInclude>
                            </dataFileIncludes>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>user-service/target/jacoco.exec</include>
                                        <include>barbershop-service/target/jacoco.exec</include>
                                        <include>schedule-service/target/jacoco.exec</include>
                                        <include>payment-service/target/jacoco.exec</include>
                                        <include>notification-service/target/jacoco.exec</include>
                                        <include>product-service/target/jacoco.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <sourceDirectories>
                                <sourceDirectory>${project.basedir}/../user-service/src/main/java</sourceDirectory>
                                <sourceDirectory>${project.basedir}/../barbershop-service/src/main/java</sourceDirectory>
                                <sourceDirectory>${project.basedir}/../schedule-service/src/main/java</sourceDirectory>
                                <sourceDirectory>${project.basedir}/../payment-service/src/main/java</sourceDirectory>
                                <sourceDirectory>${project.basedir}/../notification-service/src/main/java</sourceDirectory>
                                <sourceDirectory>${project.basedir}/../product-service/src/main/java</sourceDirectory>
                            </sourceDirectories>
                            <classDirectories>
                                <classDirectory>
                                    <directory>${project.basedir}/../user-service/target/classes</directory>
                                    <excludes>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/*Application.class</exclude>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/model/**</exclude>
                                        <exclude>**/mapper/**</exclude>
                                        <exclude>**/messaging/publisher/**</exclude>
                                    </excludes>
                                </classDirectory>
                                <classDirectory>
                                    <directory>${project.basedir}/../barbershop-service/target/classes</directory>
                                    <excludes>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/*Application.class</exclude>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/model/**</exclude>
                                        <exclude>**/mapper/**</exclude>
                                        <exclude>**/messaging/publisher/**</exclude>
                                    </excludes>
                                </classDirectory>
                                <classDirectory>
                                    <directory>${project.basedir}/../schedule-service/target/classes</directory>
                                    <excludes>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/*Application.class</exclude>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/model/**</exclude>
                                        <exclude>**/mapper/**</exclude>
                                        <exclude>**/messaging/publisher/**</exclude>
                                    </excludes>
                                </classDirectory>
                                <classDirectory>
                                    <directory>${project.basedir}/../payment-service/target/classes</directory>
                                    <excludes>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/*Application.class</exclude>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/model/**</exclude>
                                        <exclude>**/mapper/**</exclude>
                                        <exclude>**/messaging/publisher/**</exclude>
                                    </excludes>
                                </classDirectory>
                                <classDirectory>
                                    <directory>${project.basedir}/../notification-service/target/classes</directory>
                                    <excludes>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/*Application.class</exclude>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/model/**</exclude>
                                        <exclude>**/mapper/**</exclude>
                                        <exclude>**/messaging/publisher/**</exclude>
                                    </excludes>
                                </classDirectory>
                                <classDirectory>
                                    <directory>${project.basedir}/../product-service/target/classes</directory>
                                    <excludes>
                                        <exclude>**/config/**</exclude>
                                        <exclude>**/*Application.class</exclude>
                                        <exclude>**/dto/**</exclude>
                                        <exclude>**/model/**</exclude>
                                        <exclude>**/mapper/**</exclude>
                                        <exclude>**/messaging/publisher/**</exclude>
                                    </excludes>
                                </classDirectory>
                            </classDirectories>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
