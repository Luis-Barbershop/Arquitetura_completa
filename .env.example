# ==============================================================
# CortaAí — Template de Variáveis de Ambiente
# ==============================================================
# DEV local:  cp .env.example .env
# PRODUÇÃO:   cp .env.example .env.prod  (servidor ZimaOS)
# NUNCA commite .env ou .env.prod com valores reais!
# ==============================================================

# ======== MYSQL ========
MYSQL_ROOT_PASSWORD=sua_senha_mysql
DB_USERNAME=root
DB_PASSWORD=sua_senha_mysql

# ======== CRIPTOGRAFIA DE DADOS SENSÍVEIS ========
# Obrigatória para user-service e barbershop-service.
# Protege CPF, CNPJ e tokens OAuth salvos no banco. Gere com:
#   openssl rand -base64 32
CORTAAI_DATA_CRYPTO_KEY=sua_chave_base64_de_32_bytes

# ======== RABBITMQ ========
# Evite 'guest' em produção — use credenciais fortes
RABBITMQ_USER=admin
RABBITMQ_PASS=sua_senha_rabbitmq

# ======== REDIS ========
# Obrigatório em produção. Usado por gateway rate limit, schedule-service e notification-service.
REDIS_PASSWORD=sua_senha_redis

# ======== AGENDAMENTOS (schedule-service) ========
APPOINTMENT_MANUAL_COMPLETE_BEFORE_START_MINUTES=120

# ======== API GATEWAY RATE LIMIT ========
# Token bucket por usuario autenticado ou IP: 10 req/s com burst de 20 por padrao.
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20
# Login/cadastro/recuperacao de senha: mais restrito para reduzir brute force/enumeracao.
AUTH_RATE_LIMIT_REPLENISH_RATE=2
AUTH_RATE_LIMIT_BURST_CAPACITY=5

# ======== FIREBASE ========
# O JSON da service account fica em firebase-service-account.json (montado como volume)
# Obtenha em: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
# Chave Web: Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=sua_web_api_key
# Firebase Auth → Templates → Personalizar URL de ação:
#   https://web.cortaai.shop/account-action
# O continueUrl abaixo é anexado ao link pelo Firebase; a SPA decide a tela pelo parâmetro mode.
APP_WEB_BASE_URL=https://web.cortaai.shop
APP_FORGOT_PASSWORD_CONTINUE_URL=https://web.cortaai.shop/change-password

# ======== FRONTEND / PWA / WEB PUSH ========
# Local com docker-compose.yml: http://localhost:8080/api
# Produção com Nginx proxy reverso: /api
VITE_API_BASE_URL=http://localhost:8080/api
VITE_ENABLE_PWA=true
VITE_ENABLE_PUSH=false
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=sua_vapid_key_web_push

# ======== MERCADO PAGO ========
# TESTE:  credenciais em "Suas Integrações → Credenciais de teste"
# PRODUÇÃO: credenciais em "Suas Integrações → Credenciais de produção"
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN
MP_PUBLIC_KEY=SUA_PUBLIC_KEY
MP_CLIENT_ID=SEU_CLIENT_ID
MP_CLIENT_SECRET=SEU_CLIENT_SECRET
MP_AUTHORIZATION_API_BASE_URL=https://api.mercadolibre.com
# DEV local:   http://localhost:8080/api/payments/mp-callback
# PRODUÇÃO:    https://api.cortaai.shop/api/payments/mp-callback
MP_REDIRECT_URI=http://localhost:8080/api/payments/mp-callback
MP_AUTH_BASE_URL=https://auth.mercadopago.com
MP_API_BASE_URL=https://api.mercadopago.com
# DEV local:   http://localhost:5173/pagamento/conectar
# PRODUÇÃO:    https://cortaai.shop/pagamento/conectar
MP_POST_CONNECT_REDIRECT_URL=http://localhost:5173/pagamento/conectar

# ======== CLOUDINARY (user-service e barbershop-service) ========
# Obtenha em: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ======== IA — GUSTAVE (schedule-service) ========
# Cadeia de fallback: Gemini → Groq → OpenRouter → Cohere
# Se todas estiverem vazias, o chat retorna mensagem de indisponibilidade.
# Gemini:      aistudio.google.com/app/apikey
# Groq:        console.groq.com/keys
# OpenRouter:  openrouter.ai/keys  (modelo free: mistralai/mistral-7b-instruct:free)
# Cohere:      dashboard.cohere.com/api-keys  (modelo free: command-r)
GEMINI_API_KEY=sua_gemini_api_key
GROQ_API_KEY=sua_groq_api_key
OPENROUTER_API_KEY=sua_openrouter_api_key
COHERE_API_KEY=sua_cohere_api_key

# ======== EMAIL / SMTP (notification-service) ========
# Gmail: gere uma "Senha de app" em myaccount.google.com/security
# (requer verificação em 2 etapas ativada)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_16_chars
NOTIFICATION_FROM_EMAIL=noreply@cortaai.com.br

# ======== PUSH BACKEND (notification-service) ========
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_PROJECT_ID=cortaai-480b8
# Em Docker, o compose monta ./firebase-service-account.json em /app/firebase-service-account.json
NOTIFICATION_PUSH_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
