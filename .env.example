# ==============================================================
# CortaAí — Template de Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# NUNCA commite o .env com valores reais!
# ==============================================================

# ======== MYSQL ========
MYSQL_ROOT_PASSWORD=sua_senha_mysql
DB_USERNAME=root
DB_PASSWORD=sua_senha_mysql

# ======== FIREBASE AUTHENTICATION ========
# Obtenha em: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Cole o JSON completo da service account em uma única linha:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# (Alternativa para dev local): defina a variável abaixo apontando para o arquivo JSON
# export GOOGLE_APPLICATION_CREDENTIALS="/caminho/para/serviceAccountKey.json"

# ======== RABBITMQ ========
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ======== MERCADO PAGO ========
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_MERCADO_PAGO

# ======== CLOUDINARY (barbershop-service) ========
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ======== EMAIL / SMTP (notification-service) ========
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
NOTIFICATION_FROM_EMAIL=noreply@cortaai.com.br
