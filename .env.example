# ==============================================================
# CortaAí — Template de Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# NUNCA commite o .env com valores reais!
# ==============================================================

# ======== MYSQL ========
MYSQL_ROOT_PASSWORD=sua_senha_mysql
DB_USERNAME=root
DB_PASSWORD=sua_senha_mysql

# ======== JWT ========
JWT_SECRET_KEY=gere_uma_chave_secreta_com_256_bits_aqui

# ======== RABBITMQ ========
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ======== MERCADO PAGO ========
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_MERCADO_PAGO

# ======== CLOUDINARY (barbershop-service) ========
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ======== EMAIL / SMTP (notification-service) ========
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
NOTIFICATION_FROM_EMAIL=noreply@cortaai.com.br
